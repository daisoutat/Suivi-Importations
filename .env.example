# ============ Sauvegarde par courriel / Automatic backup e-mail ============
# Copiez ce fichier vers `.env` (jamais de valeurs en dur dans le code).
# Copy this file to `.env` (never commit real credentials in code).
# Variables prioritaires : SMTP_* ; les alias EMAIL_* (ancienne convention
# node/nodemailer) fonctionnent aussi.
# Priority variables: SMTP_*; the EMAIL_* aliases (legacy node/nodemailer
# naming) also work.

# --- Serveur SMTP (Gmail : app password + 2FA obligatoire) ---
SMTP_HOST=smtp.gmail.com
# Port 465  -> SMTP_SSL direct (defaut) / default
# Port 587  -> SMTP + STARTTLS (secure auto = false)
SMTP_PORT=465
# SMTP_SECURE=true     # force le transport secure (defaut : 465 = true)

# --- Compte expediteur / sender account ---
SMTP_USER=youraddress@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx     # App Password 16 caracteres / 16-char
# BACKUP_FROM=                            # optionnel, sinon SMTP_USER

# --- Destinataire / recipient ---
BACKUP_RECIPIENT=daisouta@gmail.com

# --- Planification / schedule (heure locale du serveur) ---
BACKUP_ENABLED=1
BACKUP_HOUR=15
BACKUP_MINUTE=0
BACKUP_KEEP=30

# --- Alias nodemailer legacy (facultatifs) ---
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_USER=youraddress@gmail.com
# EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_SECURE=true
# EMAIL_FROM=