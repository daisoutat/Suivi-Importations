# ============ Sauvegarde quotidienne (copier vers .env puis Render) ============
# Jamais de valeurs en dur dans le code : tout passe par l'environnement.

# --- MongoDB Atlas ---
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=                                          # optionnel : nom de la base (sinon par défaut de l'URI)
MONGO_IMPORTS_COLLECTION=imports                   # collection des fiches d'import

# --- E-mail (Gmail avec App Password, 2FA obligatoire) ---
EMAIL_USER=youraddress@gmail.com                  # expéditeur nodemailer
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx            # App Password 16 caractères (espaces OK)
EMAIL_FROM=                                       # optionnel : sinon EMAIL_USER
BACKUP_RECIPIENT=daisouta@gmail.com               # destinataire de la sauvegarde

# SMTP (valeurs Gmail par défaut — n'y touchez pas sauf besoin)
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SECURE=true

# --- Planification ---
# 03:00 PM (heure du serveur Render, UTC par défaut). Fuseau optionnel :
BACKUP_CRON=0 15 * * *
BACKUP_CRON_TZ=                                # ex: America/Montreal
BACKUP_ENABLED=true
BACKUP_MAX_DOCS=250000

# --- Test immédiat : décommentez pour une exécution toutes les minutes ---
# BACKUP_CRON=*/1 * * * *